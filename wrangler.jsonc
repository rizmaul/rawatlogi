{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "affiliate-evidence-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "affiliate-studio",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": { "APP_MODE": "local" },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "fieldnote-product-images" },
  ],
  // Cloud deployment (not deployed yet). See docs/cloudflare-deployment.md.
  // Fill in database_id and the Access values, set secrets with
  // `wrangler secret put MCP_TOKEN --env production` (and SETTINGS_ENCRYPTION_KEY),
  // then `npm run deploy:prod`.
  "env": {
    "production": {
      "name": "fieldnote",
      "vars": {
        "APP_MODE": "production",
        "ACCESS_TEAM_DOMAIN": "REPLACE-team.cloudflareaccess.com",
        "ACCESS_AUD": "REPLACE-with-Access-application-AUD-tag",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fieldnote-prod",
          "database_id": "REPLACE-with-d1-database-id",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "BUCKET", "bucket_name": "fieldnote-prod-images" },
      ],
    },
  },
}
