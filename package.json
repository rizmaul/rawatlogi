{
  "name": "affiliate-evidence-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787",
    "brand:tokens": "node scripts/brand-tokens.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "npm run deploy:prod",
    "deploy:prod": "npm run check:production && npm run build && npm run db:production && wrangler deploy --env production",
    "check:production": "node scripts/check-production.mjs",
    "db:production": "wrangler d1 migrations apply DB --env production --remote",
    "deploy:dry-run": "wrangler deploy --env production --dry-run"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "miniflare": "^5.20261104.0-beta",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
